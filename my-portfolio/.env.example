# Copie para .env e preencha. Nunca commite o .env.
# Todas estas chaves são públicas por natureza (vão para o navegador);
# a proteção dos dados fica nas regras de acesso do Supabase (supabase/schema.sql).

# Supabase > Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS > Email Services / Email Templates / Account > Public Key
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
